{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Axis-aligned bounding box in canonical coordinates.",
      "properties": {
        "maximum": {
          "$ref": "#/$defs/Point"
        },
        "minimum": {
          "$ref": "#/$defs/Point"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "FindingEvidence": {
      "additionalProperties": false,
      "description": "Source and geometric witness for a finding.",
      "properties": {
        "layer_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Id"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "witness_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "provenance"
      ],
      "title": "FindingEvidence",
      "type": "object"
    },
    "FindingStatus": {
      "description": "Finding lifecycle state.",
      "enum": [
        "OPEN",
        "CONFIRMED",
        "DISMISSED",
        "RESOLVED"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "Measurement": {
      "additionalProperties": false,
      "description": "A fact measured by deterministic code against a configured requirement.",
      "properties": {
        "actual": {
          "title": "Actual",
          "type": "number"
        },
        "config_path": {
          "minLength": 1,
          "title": "Config Path",
          "type": "string"
        },
        "error_bound": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Error Bound",
          "type": "number"
        },
        "operator": {
          "enum": [
            ">=",
            "<=",
            "=="
          ],
          "title": "Operator",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "actual",
        "required",
        "operator",
        "unit",
        "config_path"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A point in BoardGate's canonical millimetre coordinate space.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit",
          "default": "mm"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Trace a domain object back to parser and source evidence.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "title": "Metadata",
          "type": "object"
        },
        "object_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "parser": {
          "minLength": 1,
          "title": "Parser",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_coordinates": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "title": "Raw Coordinates",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_file_id": {
          "minLength": 1,
          "title": "Source File Id",
          "type": "string"
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_file_id",
        "parser",
        "parser_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RiskMode": {
      "description": "Explicit risk modes understood by orchestration and reporting.",
      "enum": [
        "FILE_INCOMPLETE",
        "FILE_TYPE_UNKNOWN",
        "UNIT_AMBIGUITY",
        "COORDINATE_MISMATCH",
        "LAYER_MAPPING_UNCERTAIN",
        "OUTLINE_UNCERTAIN",
        "GEOMETRY_VIOLATION",
        "CROSS_FILE_INCONSISTENCY",
        "DESIGN_INTENT_UNKNOWN",
        "MANUFACTURER_RULE_MISMATCH",
        "PARSER_LIMITATION"
      ],
      "title": "RiskMode",
      "type": "string"
    },
    "Severity": {
      "description": "Finding severity.",
      "enum": [
        "BLOCKER",
        "HIGH",
        "WARNING",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Optional, evidence-backed location in a source file.",
      "properties": {
        "end_byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Byte"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Byte"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "title": "SourceSpan",
      "type": "object"
    },
    "Unit": {
      "description": "Supported dimensional units.",
      "enum": [
        "mm",
        "inch",
        "mm2"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured review result that keeps facts separate from interpretation.",
  "properties": {
    "category": {
      "$ref": "#/$defs/RiskMode"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "config_path": {
      "minLength": 1,
      "title": "Config Path",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/FindingEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "facts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^fnd-[0-9a-f]{16}$",
      "title": "Finding Id",
      "type": "string"
    },
    "inference": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference"
    },
    "layer_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Layer Ids",
      "type": "array"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "measurement": {
      "anyOf": [
        {
          "$ref": "#/$defs/Measurement"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "related_findings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Related Findings",
      "type": "array"
    },
    "requires_human_confirmation": {
      "default": false,
      "title": "Requires Human Confirmation",
      "type": "boolean"
    },
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus",
      "default": "OPEN"
    },
    "suggested_action": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggested Action"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "rule_id",
    "rule_version",
    "category",
    "severity",
    "confidence",
    "config_path",
    "title",
    "summary",
    "facts",
    "evidence"
  ],
  "title": "Finding",
  "type": "object"
}
