{
  "$defs": {
    "ModificationOperation": {
      "discriminator": {
        "mapping": {
          "set_excellon_tool_diameter": "#/$defs/SetExcellonToolDiameter",
          "set_gerber_standard_aperture_diameter": "#/$defs/SetGerberStandardApertureDiameter",
          "set_placement_reference_designator": "#/$defs/SetPlacementReferenceDesignator"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SetExcellonToolDiameter"
        },
        {
          "$ref": "#/$defs/SetGerberStandardApertureDiameter"
        },
        {
          "$ref": "#/$defs/SetPlacementReferenceDesignator"
        }
      ]
    },
    "SetExcellonToolDiameter": {
      "additionalProperties": false,
      "description": "One explicitly targeted, stale-safe Excellon tool-diameter request.",
      "properties": {
        "expected_diameter_mm": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Expected Diameter Mm",
          "type": "number"
        },
        "instruction": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "kind": {
          "const": "set_excellon_tool_diameter",
          "default": "set_excellon_tool_diameter",
          "title": "Kind",
          "type": "string"
        },
        "new_diameter_mm": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "New Diameter Mm",
          "type": "number"
        },
        "operation_version": {
          "const": "1.0",
          "title": "Operation Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_file_id": {
          "pattern": "^src-[0-9a-f]{16}$",
          "title": "Source File Id",
          "type": "string"
        },
        "source_logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Logical Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "tool_code": {
          "pattern": "^T[0-9]{2,6}$",
          "title": "Tool Code",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "operation_version",
        "source_logical_path",
        "source_file_id",
        "source_sha256",
        "tool_code",
        "expected_diameter_mm",
        "new_diameter_mm",
        "instruction"
      ],
      "title": "SetExcellonToolDiameter",
      "type": "object"
    },
    "SetGerberStandardApertureDiameter": {
      "additionalProperties": false,
      "description": "One explicitly targeted, stale-safe Gerber circle-aperture request.",
      "properties": {
        "aperture_code": {
          "pattern": "^D[0-9]{1,6}$",
          "title": "Aperture Code",
          "type": "string"
        },
        "expected_diameter_mm": {
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "title": "Expected Diameter Mm",
          "type": "number"
        },
        "instruction": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "kind": {
          "const": "set_gerber_standard_aperture_diameter",
          "default": "set_gerber_standard_aperture_diameter",
          "title": "Kind",
          "type": "string"
        },
        "new_diameter_mm": {
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "title": "New Diameter Mm",
          "type": "number"
        },
        "operation_version": {
          "const": "1.0",
          "title": "Operation Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_file_id": {
          "pattern": "^src-[0-9a-f]{16}$",
          "title": "Source File Id",
          "type": "string"
        },
        "source_logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Logical Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "operation_version",
        "source_logical_path",
        "source_file_id",
        "source_sha256",
        "aperture_code",
        "expected_diameter_mm",
        "new_diameter_mm",
        "instruction"
      ],
      "title": "SetGerberStandardApertureDiameter",
      "type": "object"
    },
    "SetPlacementReferenceDesignator": {
      "additionalProperties": false,
      "description": "One explicitly targeted, stale-safe placement reference rename request.",
      "properties": {
        "expected_reference": {
          "pattern": "^[A-Z0-9][A-Z0-9_.\\-]{0,31}$",
          "title": "Expected Reference",
          "type": "string"
        },
        "instruction": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "kind": {
          "const": "set_placement_reference_designator",
          "default": "set_placement_reference_designator",
          "title": "Kind",
          "type": "string"
        },
        "new_reference": {
          "pattern": "^[A-Z0-9][A-Z0-9_.\\-]{0,31}$",
          "title": "New Reference",
          "type": "string"
        },
        "operation_version": {
          "const": "1.0",
          "title": "Operation Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_file_id": {
          "pattern": "^src-[0-9a-f]{16}$",
          "title": "Source File Id",
          "type": "string"
        },
        "source_logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Logical Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "operation_version",
        "source_logical_path",
        "source_file_id",
        "source_sha256",
        "expected_reference",
        "new_reference",
        "instruction"
      ],
      "title": "SetPlacementReferenceDesignator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One canonical, explicitly authorized modification operation.",
  "properties": {
    "base_project_id": {
      "pattern": "^prj-[0-9a-f]{16}$",
      "title": "Base Project Id",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/ModificationOperation"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "base_project_id",
    "operation"
  ],
  "title": "ModificationRequest",
  "type": "object"
}
