      "required": [
        "source_file_id",
        "logical_path",
        "sha256",
        "size_bytes",
        "file_type"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Optional, evidence-backed location in a source file.",
      "properties": {
        "end_byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Byte"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Byte"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "title": "SourceSpan",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "An explicit unknown or ambiguous project fact.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "evidence": {
          "default": [],
