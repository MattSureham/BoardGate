        "primitive_id",
        "contours",
        "polarity",
        "provenance"
      ],
      "title": "RegionPrimitive",
      "type": "object"
    },
    "RiskMode": {
      "description": "Explicit risk modes understood by orchestration and reporting.",
      "enum": [
        "FILE_INCOMPLETE",
        "FILE_TYPE_UNKNOWN",
        "UNIT_AMBIGUITY",
        "COORDINATE_MISMATCH",
        "LAYER_MAPPING_UNCERTAIN",
        "OUTLINE_UNCERTAIN",
        "GEOMETRY_VIOLATION",
        "CROSS_FILE_INCONSISTENCY",
        "DESIGN_INTENT_UNKNOWN",
        "MANUFACTURER_RULE_MISMATCH",
        "PARSER_LIMITATION"
      ],
      "title": "RiskMode",
      "type": "string"
    },
    "SourceFile": {
      "additionalProperties": false,
      "description": "Immutable metadata for one safely ingested source file.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClassificationCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "file_type": {
          "$ref": "#/$defs/FileType"
        },
        "logical_path": {
          "minLength": 1,
          "title": "Logical Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_file_id": {
          "pattern": "^src-[0-9a-f]{16}$",
          "title": "Source File Id",
          "type": "string"
        }
