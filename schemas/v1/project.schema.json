            "type": "array"
          },
          "minItems": 1,
          "title": "Contours",
          "type": "array"
        },
        "kind": {
          "const": "region",
          "default": "region",
          "title": "Kind",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity"
        },
        "primitive_id": {
          "minLength": 1,
          "title": "Primitive Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
