      "title": "ProjectManifest",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Trace a domain object back to parser and source evidence.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "title": "Metadata",
          "type": "object"
        },
        "object_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "parser": {
          "minLength": 1,
          "title": "Parser",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_coordinates": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "title": "Raw Coordinates",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_file_id": {
          "minLength": 1,
          "title": "Source File Id",
          "type": "string"
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_file_id",
        "parser",
        "parser_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
