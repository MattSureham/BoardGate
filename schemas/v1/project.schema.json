            "$ref": "#/$defs/Provenance"
          },
          "title": "Evidence",
          "type": "array"
        },
        "requires_human_confirmation": {
          "default": true,
          "title": "Requires Human Confirmation",
          "type": "boolean"
        },
        "risk_mode": {
          "$ref": "#/$defs/RiskMode"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "risk_mode",
        "subject",
        "summary"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "Unit": {
      "description": "Supported source length units.",
      "enum": [
        "mm",
        "inch"
      ],
      "title": "Unit",
      "type": "string"
    }
