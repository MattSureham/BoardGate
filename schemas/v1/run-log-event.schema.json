{
  "$defs": {
    "AnalysisDiagnosticCategory": {
      "description": "Stable fault taxonomy independent of exception implementation details.",
      "enum": [
        "INPUT",
        "CONFIGURATION",
        "SECURITY",
        "PARSER",
        "ANALYSIS",
        "OUTPUT",
        "INTERNAL"
      ],
      "title": "AnalysisDiagnosticCategory",
      "type": "string"
    },
    "AnalysisStage": {
      "description": "Stable pipeline stage associated with an analysis diagnostic.",
      "enum": [
        "DISCOVERY",
        "CONFIGURATION",
        "INGESTION",
        "PARSING",
        "NORMALIZATION",
        "PROJECT_CONSTRUCTION",
        "RULE_EXECUTION",
        "AGENT_ORCHESTRATION",
        "REPORT_COMPOSITION",
        "SVG_RENDERING",
        "ARTIFACT_VALIDATION",
        "PUBLICATION"
      ],
      "title": "AnalysisStage",
      "type": "string"
    },
    "RunLogLevel": {
      "description": "Structured run-log severity independent of transport logging.",
      "enum": [
        "ERROR",
        "WARNING",
        "INFO",
        "DEBUG"
      ],
      "title": "RunLogLevel",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One sanitized event in the public ``logs/run.jsonl`` stream.",
  "properties": {
    "category": {
      "$ref": "#/$defs/AnalysisDiagnosticCategory"
    },
    "code": {
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "title": "Code",
      "type": "string"
    },
    "drill_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drill Count"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "error_type": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "executed_rules": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Executed Rules",
      "type": "array"
    },
    "file_classification_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "File Classification Counts",
      "type": "object"
    },
    "finding_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finding Count"
    },
    "input_file_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input File Count"
    },
    "level": {
      "$ref": "#/$defs/RunLogLevel"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "primitive_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primitive Count"
    },
    "project_id": {
      "pattern": "^prj-[0-9a-f]{16}$",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_parsers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Selected Parsers",
      "type": "array"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "skipped_rule_reasons": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Skipped Rule Reasons",
      "type": "object"
    },
    "stage": {
      "$ref": "#/$defs/AnalysisStage"
    },
    "summary": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "sequence",
    "occurred_at",
    "elapsed_ms",
    "level",
    "category",
    "stage",
    "code",
    "summary"
  ],
  "title": "RunLogEvent",
  "type": "object"
}
