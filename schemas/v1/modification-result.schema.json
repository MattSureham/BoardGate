    "PayloadFileEvidence": {
      "additionalProperties": false,
      "description": "Before/after digest evidence for one emitted design file.",
      "properties": {
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "after_size_bytes": {
          "minimum": 0,
          "title": "After Size Bytes",
          "type": "integer"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "before_size_bytes": {
          "minimum": 0,
          "title": "Before Size Bytes",
          "type": "integer"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Logical Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "logical_path",
        "before_sha256",
        "after_sha256",
        "before_size_bytes",
        "after_size_bytes",
        "changed"
      ],
      "title": "PayloadFileEvidence",
      "type": "object"
    },
    "ReviewStatus": {
      "description": "Overall deterministic review result.",
      "enum": [
        "READY_FOR_REVIEW",
        "NOT_READY_FOR_FABRICATION",
        "READY_WITH_CONFIRMATIONS",
        "INSUFFICIENT_INFORMATION",
        "ANALYSIS_FAILED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RevisionValidationEvidence": {
      "additionalProperties": false,
      "description": "Identity and conclusion of the independent post-emission review.",
      "properties": {
        "finding_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "overall_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj-[0-9a-f]{16}$",
          "title": "Project Id",
          "type": "string"
        },
        "review_artifact_directory": {
          "const": "validation",
          "default": "validation",
          "title": "Review Artifact Directory",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "profile_id",
        "profile_sha256",
        "overall_status"
      ],
      "title": "RevisionValidationEvidence",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Optional, evidence-backed location in a source file.",
      "properties": {
        "end_byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Byte"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Byte"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic evidence binding one request, revision, and fresh review.",
  "properties": {
    "base_project_id": {
      "pattern": "^prj-[0-9a-f]{16}$",
      "title": "Base Project Id",
      "type": "string"
    },
    "disclaimer": {
      "default": "This revision records a deterministic file modification and an independent BoardGate review; it does not guarantee manufacturability or replace fabricator and engineer approval.",
      "maxLength": 500,
      "minLength": 1,
      "title": "Disclaimer",
      "type": "string"
    },
    "implementation_version": {
      "minLength": 1,
      "title": "Implementation Version",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/AppliedModificationOperation"
    },
    "operation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operation Sha256",
      "type": "string"
    },
    "output_project_id": {
      "pattern": "^prj-[0-9a-f]{16}$",
      "title": "Output Project Id",
      "type": "string"
    },
    "payload_files": {
      "items": {
        "$ref": "#/$defs/PayloadFileEvidence"
      },
      "minItems": 1,
      "title": "Payload Files",
      "type": "array"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^rev-[0-9a-f]{16}$",
