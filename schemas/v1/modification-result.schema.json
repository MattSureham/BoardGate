          "set_placement_dnp_state": "#/$defs/AppliedPlacementDnpStateChange",
          "set_placement_reference_designator": "#/$defs/AppliedPlacementReferenceDesignatorChange"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AppliedExcellonToolDiameterChange"
        },
        {
          "$ref": "#/$defs/AppliedGerberStandardApertureDiameterChange"
        },
        {
