    "AppliedModificationOperation": {
      "discriminator": {
        "mapping": {
          "set_excellon_tool_diameter": "#/$defs/AppliedExcellonToolDiameterChange",
          "set_gerber_standard_aperture_diameter": "#/$defs/AppliedGerberStandardApertureDiameterChange",
